# LLM provider credentials used by generation scripts.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional generation throttling.
CLAUDE_MIN_INTERVAL_SECONDS=12
CLAUDE_REQUEST_TIMEOUT_SECONDS=60
CLAUDE_SDK_MAX_RETRIES=0

# Optional output location for generation checkpoints/workbooks.
TEXT2SQL_GENERATION_OUTPUT_DIR=artifacts/generation_outputs

# Optional workbook/result locations for SQL runtime orchestration.
TEXT2SQL_BATCH1_WORKBOOK=benchmark/workbooks/master_results_batch_1.xlsx
TEXT2SQL_BATCH2_WORKBOOK=benchmark/workbooks/master_results_batch_2.xlsx
TEXT2SQL_BATCH3_WORKBOOK=benchmark/workbooks/master_results_batch_3.xlsx
TEXT2SQL_BATCH4_WORKBOOK=benchmark/workbooks/master_results_batch_4.xlsx
TEXT2SQL_SQL_RESULT_ROOT=artifacts/sql_run_result_final
TEXT2SQL_FINAL_RESULT_ROOT=artifacts/final_result_files
BATCH_RESULT_STORAGE_ROOT=

# Optional SQL Server connection override for Biomed CSV imports.
TEXT2SQL_BIOMED_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};SERVER=.\\SQLEXPRESS;DATABASE=biomed;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes;
TEXT2SQL_BIOMED_CSV_DIR=data/biomed_csv_files/done
